[Unit]
Description=CloudStream sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erdogan
WorkingDirectory=/home/erdogan/cloudstream-sync
EnvironmentFile=/home/erdogan/cloudstream-sync/.env
ExecStart=/usr/bin/node src/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
